{
  "schemaVersion": 1,
  "id": "cardboard",
  "version": "${version}",

  "name": "Cardboard",
  "description": "An implementation of the popular Spigot/Paper API for Fabric",
  "authors": [
    "Isaiah"
  ],
  "contact": {
    "homepage": "https://cardboardpowered.org/",
    "sources": "https://github.com/CardboardPowered/"
  },

  "license": "GPLv3",
  "icon": "assets/fabricbukkit/icon.png",
  "accessWidener" : "bukkitfabric.accesswidener",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.javazilla.bukkitfabric.BukkitFabricMod"
    ]
  },
  "mixins": [
    "bukkitfabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "java": ">=21",
    "icommon": "*",
    "minecraft": ">=26.2"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/server/MinecraftServer": ["org/cardboardpowered/bridge/server/MinecraftServerBridge"],
      "net/minecraft/world/entity/Entity": ["org/cardboardpowered/bridge/world/entity/EntityBridge"],
      "net/minecraft/server/level/ServerPlayer": ["org/cardboardpowered/bridge/server/level/ServerPlayerBridge"],
      "net/minecraft/world/level/Level": ["org/cardboardpowered/bridge/world/level/LevelBridge"],
      "net/minecraft/server/level/ServerLevel": ["org/cardboardpowered/bridge/server/level/ServerLevelBridge"],
      "net/minecraft/server/network/ServerLoginPacketListenerImpl": ["org/cardboardpowered/bridge/server/network/ServerLoginPacketListenerImplBridge"]
    },
    "fabric:itf": {
      "net/minecraft/server/MinecraftServer": [
        "org/cardboardpowered/bridge/IMinecraftServerStatic"
      ]
    }
  }

}
